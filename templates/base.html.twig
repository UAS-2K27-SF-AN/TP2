<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}TP Symfony{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            :root {
                color-scheme: light;
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                color: #e883ed;
                background: #87ceeb;
            }

            * { box-sizing: border-box; }

            body {
                min-height: 100vh;
                margin: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 32px 20px;
                background: #87ceeb;
            }

            nav {
                position: static;
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 18px;
            }

            nav a {
                padding: 10px 14px;
                color: #111827;
                background: #fff7fb;
                border: 1px solid #efb6d2;
                border-radius: 999px;
                font-size: .9rem;
                font-weight: 700;
                text-decoration: none;
                box-shadow: 0 5px 14px rgba(157, 74, 133, .16);
            }

            nav a:hover { background: #f8d8e8; }

            main {
                width: min(100%, 720px);
                padding: clamp(32px, 7vw, 72px);
                text-align: center;
                background: #ffe4ef;
                border: 2px solid #f4b8d0;
                border-radius: 28px;
                box-shadow: 0 18px 45px rgba(157, 74, 133, .22);
                color: #95518f;
                animation: cadre-float 3s ease-in-out infinite;
            }

            @keyframes cadre-float {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-8px); }
            }

            @media (prefers-reduced-motion: reduce) {
                main { animation: none; }
            }

            h1, h2 { margin-top: 0; color: #95518f; letter-spacing: -.04em; }
            h1 { font-size: clamp(2rem, 6vw, 4rem); }
            h2 { font-size: clamp(1.8rem, 5vw, 3rem); }
            p { color: #95518f; font-size: 1.12rem; line-height: 1.7; }
            strong { color: #c45b9b; font-size: 1.5em; }

            footer {
                margin-top: 24px;
                color: #a56b9e;
                font-size: .9rem;
                text-align: center;
            }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <nav aria-label="Navigation principale">
            <a href="{{ path('app_hello', {name: 'Ahmed'}) }}">Bonjour</a>
            <a href="{{ path('app_addition', {a: 10, b: 5}) }}">Addition</a>
            <a href="{{ path('app_motivation') }}">Motivation</a>
        </nav>
        <main>
            {% block body %}{% endblock %}
        </main>
        <footer><small>{{ app_name }} - version {{ app_version }}</small></footer>
    </body>
</html>
